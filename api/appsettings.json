{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Orders": {
    "TaxRate": 0.0825
  },
  "Statistics": {
    "TimeZone": "America/Mexico_City"
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenMinutes": 30,
    "RequireConfirmedEmail": true
  },
  "Email": {
    "FromAddress": "no-reply@pizzashop.dev",
    "FromName": "Pizza Shop",
    "WebBaseUrl": "http://localhost:3000",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None"
    }
  },
  "RateLimiting": {
    "AuthPerMinute": 20,
    "UserPerMinute": 300,
    "OrderCreatePerMinute": 20
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
