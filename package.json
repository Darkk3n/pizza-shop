{
	"name": "pizza-shop-pos-monorepo",
	"private": true,
	"scripts": {
		"dev": "concurrently -n web,api,open -c cyan,magenta,gray \"pnpm:dev:web\" \"pnpm:dev:api\" \"wait-on http-get://localhost:3000 && open-cli http://localhost:3000\"",
		"dev:web": "pnpm --filter web dev",
		"dev:api": "dotnet watch run --project api/PizzaShop.Api.csproj",
		"db:up": "podman compose up -d",
		"db:down": "podman compose down"
	},
	"devDependencies": {
		"concurrently": "^10.0.6",
		"open-cli": "^9.0.0",
		"wait-on": "^9.5.1"
	},
	"packageManager": "pnpm@12.3.4"
}
